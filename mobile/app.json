{
  "expo": {
    "name": "360Biznes",
    "slug": "biznes360",
    "owner": "sabiroglu-limited",
    "scheme": "biznes360",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "az.biznes360.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Məhsul şəkli çəkmək və barkod skan etmək üçün kamera istifadə olunur.",
        "NSPhotoLibraryUsageDescription": "Məhsula şəkil əlavə etmək üçün foto qalereyaya giriş istənilir."
      }
    },
    "android": {
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "backgroundColor": "#ccfbf1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "az.biznes360.app",
      "versionCode": 7,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Barkod skan etmək və məhsul şəkli çəkmək üçün kameradan istifadə olunur."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Məhsula şəkil əlavə etmək üçün qalereyaya giriş istənilir.",
          "cameraPermission": "Məhsul şəkli çəkmək üçün kameradan istifadə olunur."
        }
      ]
    ],
    "extra": {
      "apiBase": "http://localhost:3500",
      "router": {},
      "eas": {
        "projectId": "b474434a-f202-4e74-a8b4-da9c25be9749"
      }
    }
  }
}
