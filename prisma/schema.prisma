generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model abune_planlari {
  id              Int           @id @default(autoincrement())
  kod             String        @unique @db.VarChar(30)
  ad              String        @db.VarChar(80)
  ayl_q_qiymet    Decimal       @map("aylıq_qiymet") @db.Decimal(10, 2)
  illik_qiymet    Decimal?      @db.Decimal(10, 2)
  max_istifadeci  Int?
  max_mehsul      Int?
  max_mesaj_ayl_q Int?          @map("max_mesaj_aylıq")
  funksiyalar     Json?
  aktiv           Boolean?      @default(true)
  yaradildi       DateTime?     @default(now()) @db.Timestamp(6)
  abuneler        abuneler[]
  demo_trials     demo_trials[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model abuneler {
  id             Int            @id @default(autoincrement())
  sahibkar_id    String         @db.Uuid
  plan_id        Int
  baslama        DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  bitme          DateTime       @db.Date
  novu           String?        @default("aylıq") @db.VarChar(10)
  status         String?        @default("aktiv") @db.VarChar(20)
  son_odenis     DateTime?      @db.Date
  meblegh        Decimal?       @db.Decimal(10, 2)
  qeyd           String?
  yaradildi      DateTime?      @default(now()) @db.Timestamp(6)
  abune_planlari abune_planlari @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sahibkarlar    sahibkarlar    @relation(fields: [sahibkar_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sahibkar_id], map: "idx_abune_sahibkar")
  @@index([status], map: "idx_abune_status")
}

model ai_insiqht {
  id            Int            @id @default(autoincrement())
  sahibkar_id   String         @db.Uuid
  istifadeci_id String?        @db.Uuid
  tip           String?        @db.VarChar(40)
  basliq        String?        @db.VarChar(300)
  metn          String?
  metric_json   Json?
  action_json   Json?
  prioritet     String?        @db.VarChar(20)
  oxundu        Boolean?       @default(false)
  faydaly       Boolean?
  yaradildi     DateTime?      @default(now()) @db.Timestamp(6)
  istifadeciler istifadeciler? @relation(fields: [istifadeci_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sahibkarlar   sahibkarlar    @relation(fields: [sahibkar_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sahibkar_id, tip, yaradildi(sort: Desc)], map: "idx_ai_sah")
}

model ai_sohbet_loq {
  id              BigInt           @id @default(autoincrement())
  sahibkar_id     String           @db.Uuid
  sohbet_id       String?          @db.Uuid
  mesaj_id        BigInt?
  istifadeci_id   String?          @db.Uuid
  model           String?          @db.VarChar(50)
  prompt          String
  cavab           String
  niyyet          String?          @db.VarChar(30)
  uslub           String?          @db.VarChar(20)
  kanal           String?          @db.VarChar(20)
  mehsul_id       String?          @db.Uuid
  istifade_olundu Boolean?         @default(false)
  reaksiya        String?          @db.VarChar(20)
  satisa_cevrildi Boolean?         @default(false)
  yaradildi       DateTime?        @default(now()) @db.Timestamp(6)
  istifadeciler   istifadeciler?   @relation(fields: [istifadeci_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inbox_mesajlari inbox_mesajlari? @relation(fields: [mesaj_id], references: [id], onUpdate: NoAction)
  sahibkarlar     sahibkarlar      @relation(fields: [sahibkar_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inbox_sohbetler inbox_sohbetler? @relation(fields: [sohbet_id], references: [id], onUpdate: NoAction)

  @@index([sahibkar_id, yaradildi(sort: Desc)], map: "idx_ai_log_sahibkar")
  @@index([sohbet_id], map: "idx_ai_log_sohbet")
}

model ai_sual {
  id            Int            @id @default(autoincrement())
  sahibkar_id   String         @db.Uuid
  istifadeci_id String?        @db.Uuid
  sual          String?
  cavab         String?
  metric_json   Json?
  action_json   Json?
  yaradildi     DateTime?      @default(now()) @db.Timestamp(6)
  istifadeciler istifadeciler? @relation(fields: [istifadeci_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sahibkarlar   sahibkarlar    @relation(fields: [sahibkar_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model alert_ai_insights {
  id          Int         @id @default(autoincrement())
  sahibkar_id String      @db.Uuid
  tarix       DateTime    @db.Date
  xulasse     String?
  top_riskler Json?
  tovsiyeler  Json?
  yaradildi   DateTime?   @default(now()) @db.Timestamp(6)
  sahibkarlar sahibkarlar @relation(fields: [sahibkar_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sahibkar_id, tarix])
}

model alert_categories {
  id          Int           @id @default(autoincrement())
  kod         String        @unique @db.VarChar(40)
  ad          String        @db.VarChar(100)
  emoji       String?       @db.VarChar(8)
  ikon        String?       @db.VarChar(40)
  reng        String?       @db.VarChar(20)
  qrup        String?       @db.VarChar(40)
  siralama    Int?          @default(0)
  aktiv       Boolean?      @default(true)
  yaradildi   DateTime?     @default(now()) @db.Timestamp(6)
  alert_rules alert_rules[]
  alerts      alerts[]
}

model alert_comments {
  id            Int            @id @default(autoincrement())
  alert_id      String         @db.Uuid
  istifadeci_id String?        @db.Uuid
  metn          String
  yaradildi     DateTime?      @default(now()) @db.Timestamp(6)
  alerts        alerts         @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  istifadeciler istifadeciler? @relation(fields: [istifadeci_id], references: [id], onUpdate: NoAction)

  @@index([alert_id, yaradildi(sort: Desc)], map: "idx_acom_alert")
}

model alert_escalations {
  id                                                          Int            @id @default(autoincrement())
  alert_id                                                    String         @db.Uuid
  escalated_to                                                String?        @db.Uuid
  escalated_by                                                String?        @db.Uuid
  sebeb                                                       String?
  yaradildi                                                   DateTime?      @default(now()) @db.Timestamp(6)
  alerts                                                      alerts         @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  istifadeciler_alert_escalations_escalated_byToistifadeciler istifadeciler? @relation("alert_escalations_escalated_byToistifadeciler", fields: [escalated_by], references: [id], onUpdate: NoAction)
  istifadeciler_alert_escalations_escalated_toToistifadeciler istifadeciler? @relation("alert_escalations_escalated_toToistifadeciler", fields: [escalated_to], references: [id], onUpdate: NoAction)
}

model alert_rules {
  id               Int               @id @default(autoincrement())
  sahibkar_id      String            @db.Uuid
  ad               String            @db.VarChar(200)
  kateqoriya_id    Int?
  kod              String            @db.VarChar(60)
  shart            Json?
  seviyye          String?           @default("risk") @db.VarChar(20)
  hedef            String?           @default("hami") @db.VarChar(20)
  hedef_id         String?           @db.Uuid
  rol              String?           @db.VarChar(40)
  filial_id        Int?
  kanallar         Json?             @default("[\"app\"]")
  tekrar_sa        Int?              @default(0)
  avto_tapshiriq   Boolean?          @default(false)
  tapshiriq_tip    String?           @db.VarChar(40)
  kpi_tesiri       Boolean?          @default(false)
  aktiv            Boolean?          @default(true)
  yaradan_id       String?           @db.Uuid
  yaradildi        DateTime?         @default(now()) @db.Timestamp(6)
  yenilendi        DateTime?         @default(now()) @db.Timestamp(6)
  filiallar        filiallar?        @relation(fields: [filial_id], references: [id], onUpdate: NoAction)
  alert_categories alert_categories? @relation(fields: [kateqoriya_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sahibkarlar      sahibkarlar       @relation(fields: [sahibkar_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  istifadeciler    istifadeciler?    @relation(fields: [yaradan_id], references: [id], onUpdate: NoAction)
  alerts           alerts[]

  @@unique([sahibkar_id, kod, hedef_id, filial_id])
  @@index([sahibkar_id, aktiv], map: "idx_arul_sah")
}

model alert_status_history {
  id            BigInt         @id @default(autoincrement())
  alert_id      String         @db.Uuid
  kohne_status  String?        @db.VarChar(20)
  yeni_status   String         @db.VarChar(20)
  istifadeci_id String?        @db.Uuid
  qeyd          String?
  yaradildi     DateTime?      @default(now()) @db.Timestamp(6)
  alerts        alerts         @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  istifadeciler istifadeciler? @relation(fields: [istifadeci_id], references: [id], onUpdate: NoAction)

  @@index([alert_id, yaradildi(sort: Desc)], map: "idx_ash_alert")
}

model alert_user_preferences {
  istifadeci_id String        @id @db.Uuid
  default_view  String?       @default("list") @db.VarChar(20)
  filterler     Json?
  kanallar      Json?         @default("[\"app\"]")
  yenilendi     DateTime?     @default(now()) @db.Timestamp(6)
  istifadeciler istifadeciler @relation(fields: [istifadeci_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

