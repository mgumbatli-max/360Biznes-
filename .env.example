# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/biznes_360_next?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/biznes_360_next?schema=public"

# NextAuth
AUTH_SECRET=""              # openssl rand -hex 32
AUTH_URL="http://localhost:3000"

# JWT
JWT_SECRET=""               # openssl rand -hex 32 (≥32 chars in prod)
JWT_EXPIRES_IN="7d"

# Anthropic Claude
ANTHROPIC_API_KEY=""        # Empty → mock AI responses
AI_MODEL="claude-haiku-4-5-20251001"

# Redis (background jobs, session cache)
REDIS_URL=""                # redis://localhost:6379

# Mobile API
MOBILE_JWT_SECRET=""            # openssl rand -base64 48

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="360Biznes"
