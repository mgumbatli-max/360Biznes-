# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/biznes_360_next?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/biznes_360_next?schema=public"

# NextAuth
AUTH_SECRET=""              # openssl rand -hex 32
AUTH_URL="http://localhost:3000"

# JWT
JWT_SECRET=""               # openssl rand -hex 32 (≥32 chars in prod)
JWT_EXPIRES_IN="7d"

# Anthropic Claude
ANTHROPIC_API_KEY=""        # Empty → mock AI responses
AI_MODEL="claude-haiku-4-5-20251001"

# Redis (background jobs, session cache)
REDIS_URL=""                # redis://localhost:6379

# Mobile API
MOBILE_JWT_SECRET=""            # openssl rand -base64 48

# Servis approval token (HMAC) — boş olsa AUTH_SECRET istifadə olunur
SERVIS_TOKEN_SECRET=""         # openssl rand -hex 32 (opsional)

# Platform super-admin — YALNIZ platforma sahibinin profili; rolla verilmir.
# Hər ikisi qoyulmalıdır, yoxsa heç kim super-admin deyil (fail-closed).
SUPER_ADMIN_EMAILS=""          # icazəli email(lər), vergüllə: a@x.com,b@y.com
SUPER_ADMIN_SAHIBKAR_ID=""     # platforma sahibinin sahibkar_id (uuid) — DB-dən

# QA / Playwright test fixturu (lokal seed hesabı — prod-da OLMAMALIDIR)
QA_TEST_EMAIL="test-sahibkar@example.com"
QA_TEST_PASSWORD=""

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="360Biznes"
